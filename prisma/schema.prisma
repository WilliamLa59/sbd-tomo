generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")

  @@map("gender")
}

enum WeightUnit {
  KG @map("kg")
  LB @map("lb")

  @@map("weight_unit")
}

enum TeamRole {
  COACH           @map("coach")
  ASSISTANT_COACH @map("assistant_coach")
  ATHLETE         @map("athlete")

  @@map("team_role")
}

enum TrainingSessionStatus {
  PLANNED     @map("planned")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  SKIPPED     @map("skipped")

  @@map("training_session_status")
}

enum SetType {
  WARMUP   @map("warmup")
  WORKING  @map("working")
  TOP      @map("top")
  BACKDOWN @map("backdown")
  AMRAP    @map("amrap")

  @@map("set_type")
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth")

  heightCm                 Decimal?   @map("height_cm")
  competitionWeightClassKg Decimal?   @map("competition_weight_class_kg")
  preferredUnit            WeightUnit @default(KG) @map("preferred_unit")
  timezone                 String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions Session[]
  accounts Account[]

  teamMemberships TeamMembership[]

  createdExercises Exercise[] @relation("ExerciseCreator")

  programs        Program[] @relation("ProgramAthlete")
  createdPrograms Program[] @relation("ProgramCreator")

  trainingSessions TrainingSession[]
  personalRecords  PersonalRecord[]

  @@unique([email], map: "users_email_key")
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([token], map: "sessions_token_key")
  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model Account {
  id         String @id
  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  scope    String?
  password String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId], map: "accounts_user_id_idx")
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}

model Team {
  id   String @id @default(cuid())
  name String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships             TeamMembership[]
  coachAthleteAssignments CoachAthleteAssignment[]
  settings                TeamSettings?
  programs                Program[]

  @@map("teams")
}

model TeamMembership {
  id String @id @default(cuid())

  teamId String @map("team_id")
  userId String @map("user_id")

  role TeamRole

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  coachAssignments   CoachAthleteAssignment[] @relation("CoachMembership")
  athleteAssignments CoachAthleteAssignment[] @relation("AthleteMembership")

  @@index([userId], map: "team_memberships_user_id_idx")
  @@index([teamId], map: "team_memberships_team_id_idx")
  @@index([teamId, userId], map: "team_memberships_team_user_idx")
  @@map("team_memberships")
}

model CoachAthleteAssignment {
  id String @id @default(cuid())

  teamId              String @map("team_id")
  coachMembershipId   String @map("coach_membership_id")
  athleteMembershipId String @map("athlete_membership_id")

  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  coachMembership TeamMembership @relation("CoachMembership", fields: [coachMembershipId], references: [id], onDelete: Cascade)

  athleteMembership TeamMembership @relation("AthleteMembership", fields: [athleteMembershipId], references: [id], onDelete: Cascade)

  @@index([teamId], map: "coach_athlete_assignments_team_id_idx")
  @@index([coachMembershipId], map: "coach_athlete_assignments_coach_membership_id_idx")
  @@index([athleteMembershipId], map: "coach_athlete_assignments_athlete_membership_id_idx")
  @@index([coachMembershipId, athleteMembershipId], map: "coach_athlete_assignments_coach_athlete_idx")
  @@map("coach_athlete_assignments")
}

model TeamSettings {
  id String @id @default(cuid())

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  allowAthleteStatsVisibility       Boolean @default(false) @map("allow_athlete_stats_visibility")
  allowAssistantCoachSelfAssignment Boolean @default(false) @map("allow_assistant_coach_self_assignment")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([teamId], map: "team_settings_team_id_key")
  @@map("team_settings")
}

model Exercise {
  id String @id @default(cuid())

  name String
  slug String

  parentExerciseId String? @map("parent_exercise_id")
  createdByUserId  String? @map("created_by_user_id")

  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parentExercise Exercise?  @relation("ExerciseVariations", fields: [parentExerciseId], references: [id], onDelete: SetNull)
  variations     Exercise[] @relation("ExerciseVariations")

  createdByUser User? @relation("ExerciseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  trainingSessionExercises TrainingSessionExercise[]
  personalRecords          PersonalRecord[]

  @@index([parentExerciseId], map: "exercises_parent_exercise_id_idx")
  @@index([createdByUserId], map: "exercises_created_by_user_id_idx")
  @@index([slug], map: "exercises_slug_idx")
  @@map("exercises")
}

model Program {
  id String @id @default(cuid())

  userId          String  @map("user_id")
  teamId          String? @map("team_id")
  createdByUserId String? @map("created_by_user_id")

  name        String
  description String?

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user          User  @relation("ProgramAthlete", fields: [userId], references: [id], onDelete: Cascade)
  team          Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("ProgramCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  blocks ProgramBlock[]

  @@index([userId], map: "programs_user_id_idx")
  @@index([teamId], map: "programs_team_id_idx")
  @@index([createdByUserId], map: "programs_created_by_user_id_idx")
  @@map("programs")
}

model ProgramBlock {
  id String @id @default(cuid())

  programId String  @map("program_id")
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  name          String
  blockNumber   Int    @map("block_number")
  numberOfWeeks Int    @map("number_of_weeks")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  trainingSessions TrainingSession[]

  @@index([programId], map: "program_blocks_program_id_idx")
  @@index([programId, blockNumber], map: "program_blocks_program_block_number_idx")
  @@map("program_blocks")
}

model TrainingSession {
  id String @id @default(cuid())

  userId  String  @map("user_id")
  blockId String? @map("block_id")

  weekNumber Int? @map("week_number")
  dayNumber  Int? @map("day_number")

  name          String?
  scheduledDate DateTime? @map("scheduled_date")
  completedAt   DateTime? @map("completed_at")

  status TrainingSessionStatus @default(PLANNED)

  bodyweightKg Decimal? @map("bodyweight_kg")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  block ProgramBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  exercises TrainingSessionExercise[]

  @@index([userId], map: "training_sessions_user_id_idx")
  @@index([blockId], map: "training_sessions_block_id_idx")
  @@index([blockId, weekNumber, dayNumber], map: "training_sessions_block_week_day_idx")
  @@map("training_sessions")
}

model TrainingSessionExercise {
  id String @id @default(cuid())

  trainingSessionId String @map("training_session_id")
  exerciseId        String @map("exercise_id")

  exerciseOrder Int @map("exercise_order")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])

  prescribedSets PrescribedSet[]
  performedSets  PerformedSet[]

  @@index([trainingSessionId], map: "training_session_exercises_training_session_id_idx")
  @@index([exerciseId], map: "training_session_exercises_exercise_id_idx")
  @@index([trainingSessionId, exerciseOrder], map: "training_session_exercises_session_order_idx")
  @@map("training_session_exercises")
}

model PrescribedSet {
  id String @id @default(cuid())

  trainingSessionExerciseId String @map("training_session_exercise_id")

  setNumber Int     @map("set_number")
  setType   SetType @default(WORKING) @map("set_type")

  weightKg Decimal? @map("weight_kg")
  reps     Int?

  rpe Decimal?
  rir Decimal?

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  trainingSessionExercise TrainingSessionExercise @relation(fields: [trainingSessionExerciseId], references: [id], onDelete: Cascade)

  performedSets PerformedSet[]

  @@index([trainingSessionExerciseId], map: "prescribed_sets_training_session_exercise_id_idx")
  @@index([trainingSessionExerciseId, setNumber], map: "prescribed_sets_exercise_set_number_idx")
  @@map("prescribed_sets")
}

model PerformedSet {
  id String @id @default(cuid())

  trainingSessionExerciseId String  @map("training_session_exercise_id")
  prescribedSetId           String? @map("prescribed_set_id")

  setNumber Int     @map("set_number")
  setType   SetType @default(WORKING) @map("set_type")

  weightKg Decimal @map("weight_kg")
  reps     Int

  rpe Decimal?
  rir Decimal?

  completedAt DateTime? @map("completed_at")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  trainingSessionExercise TrainingSessionExercise @relation(fields: [trainingSessionExerciseId], references: [id], onDelete: Cascade)
  prescribedSet           PrescribedSet?          @relation(fields: [prescribedSetId], references: [id], onDelete: SetNull)

  personalRecords PersonalRecord[]

  @@index([trainingSessionExerciseId], map: "performed_sets_training_session_exercise_id_idx")
  @@index([prescribedSetId], map: "performed_sets_prescribed_set_id_idx")
  @@map("performed_sets")
}

model PersonalRecord {
  id String @id @default(cuid())

  userId         String @map("user_id")
  exerciseId     String @map("exercise_id")
  performedSetId String @map("performed_set_id")

  weightKg Decimal @map("weight_kg")
  reps     Int

  achievedAt DateTime @map("achieved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id])
  performedSet PerformedSet @relation(fields: [performedSetId], references: [id])

  @@index([userId], map: "personal_records_user_id_idx")
  @@index([exerciseId], map: "personal_records_exercise_id_idx")
  @@index([performedSetId], map: "personal_records_performed_set_id_idx")
  @@index([userId, exerciseId, reps], map: "personal_records_user_exercise_reps_idx")
  @@map("personal_records")
}
